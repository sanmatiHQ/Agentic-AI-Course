# Copy to secrets.toml for local dev (gitignored).
# On Streamlit Cloud: App settings → Secrets — paste this block with real values.
#
# Keys are server-side only: never committed, never shown in the UI.

OPENAI_API_KEY = "sk-..."
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional — require this PIN before Concept Explainer loads (stops public visitors
# from using your hosted keys). Leave empty or omit to skip the gate.
PORTFOLIO_ACCESS_PIN = ""

